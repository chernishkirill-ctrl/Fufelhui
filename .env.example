# ===== Обязательные =====
# Токен бота от @BotFather
BOT_TOKEN=123456789:AA...
# Telegram user ID владельца (единственный доступ к админ-пульту). Узнать: /id в боте или @userinfobot
OWNER_ID=123456789
# PostgreSQL. Render выдает postgres://... — формат преобразуется автоматически
DATABASE_URL=postgresql://user:password@localhost:5432/crm

# ===== Рабочий чат (супергруппа с Topics) =====
WORK_CHAT_ID=-1001234567890
BASE_TOPIC_ID=
ARCHIVE_TOPIC_ID=
DEALS_TOPIC_ID=
CHAT_TOPIC_ID=
# Тема для заявок клиентов (если пусто — заявки идут в тему «База»)
LEADS_TOPIC_ID=

# ===== Публичный канал =====
# -100... или @username канала
PUBLIC_CHANNEL_ID=-1009876543210

# ===== Опционально =====
# Токен Telegraph (если пусто — аккаунт создается автоматически и хранится в БД)
TELEGRAPH_TOKEN=
AGENCY_NAME=Nestima Real Estate
# Хэштег агентства в публикациях (без #), пусто — не добавлять
AGENCY_HASHTAG=
DEFAULT_CITY=Днепр
DEFAULT_CURRENCY=USD
TIMEZONE=Europe/Kyiv
# Время запроса ежедневного отчета (можно менять из бота в ⚙️ Настройки)
REPORT_TIME=22:00

# ===== Запуск =====
# polling — локально; webhook — на сервере. Пусто: webhook, если задан WEBHOOK_BASE_URL/RENDER_EXTERNAL_URL
BOT_MODE=polling
# Публичный URL сервиса (на Render не нужен — берется RENDER_EXTERNAL_URL)
WEBHOOK_BASE_URL=
# Секрет для проверки запросов от Telegram (пусто — выводится из BOT_TOKEN)
WEBHOOK_SECRET=
# Секрет для /cron/* эндпоинтов (внешний планировщик); пусто — эндпоинты отключены
CRON_SECRET=
PORT=8080
LOG_LEVEL=INFO
